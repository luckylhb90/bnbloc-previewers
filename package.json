    "@bnbloc/previewer-sdk": "github:luckylhb90/bnbloc#a691abac&path:/web/previewer-sdk",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
