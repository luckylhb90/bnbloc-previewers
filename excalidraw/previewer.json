{
  "kind": "bnbloc.previewer.package/v1",
  "contract": "bnbloc.previewer.contract/v1",
  "runtime": "bundle",
  "name": "excalidraw",
  "version": "1.0.0",
  "publisher": "bnbloc",
  "description": "Excalidraw drawings (.excalidraw): drawn in the editor, edited and saved as new versions; point at a shape or an arrow to ask about it.",
  "artifacts": {
    "bundle": { "url": "", "sha256": "" }
  },
  "previewer": {
    "entry": "index.html",
    "match": {
      "mimeTypes": ["application/vnd.excalidraw+json"],
      "extensions": [".excalidraw", ".excalidraw.json"]
    },
    "rank": 50,
    "capabilities": ["thumbnail", "toolbar", "selection", "units", "edit"],
    "toolbar": [
      { "id": "zoom", "icon": "zoom-in", "label": "Zoom", "kind": "zoom" },
      { "id": "fit", "icon": "fit", "label": "Fit to view", "kind": "button" }
    ]
  }
}
